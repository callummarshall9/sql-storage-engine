<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>sql_storage_engine</RootNamespace>
        <ImplicitUsings>disable</ImplicitUsings>
        <cCoderCodeAnalysisArchitecturePath>$(MSBuildProjectDirectory)/obj/project.stxjson</cCoderCodeAnalysisArchitecturePath>
        <Nullable>enable</Nullable>
        <PackageId>SqlStorageEngine</PackageId>
        <Version>2.0.0</Version>
        <Authors>Callum Marshall</Authors>
        <Description>A page-oriented storage core for opaque records and ordered keys, with buffering, heaps, indexes, transactions, WAL, recovery, and physical backups.</Description>
        <PackageTags>storage-engine;database;wal;b-plus-tree</PackageTags>
        <RepositoryUrl>https://github.com/callummarshall9/sql-storage-engine</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="cCoder.CodeAnalysis" Version="2026.10.8.1211" PrivateAssets="all" />
        <PackageReference Include="cCoder.CodeAnalysis.Contracts" Version="2026.10.8.1211" />
        <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
        <PackageReference Include="System.Reactive" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="sql-storage-engine.UnitTests" />
        <InternalsVisibleTo Include="TransactionCrashProbe" />
    </ItemGroup>

</Project>
