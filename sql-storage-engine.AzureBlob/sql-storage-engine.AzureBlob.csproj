<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>sql_storage_engine.AzureBlob</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <cCoderCodeAnalysisArchitecturePath>$(MSBuildProjectDirectory)/obj/project.stxjson</cCoderCodeAnalysisArchitecturePath>
    <PackageId>SqlStorageEngine.AzureBlob</PackageId>
    <Version>2.0.0</Version>
    <Description>Optional Azure Blob object storage provider for SqlStorageEngine.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SqlStorageEngine/SqlStorageEngine.csproj" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="cCoder.CodeAnalysis" Version="2026.10.8.1211" PrivateAssets="all" />
    <PackageReference Include="cCoder.CodeAnalysis.Contracts" Version="2026.10.8.1211" />
  </ItemGroup>
</Project>
